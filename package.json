{
  "name": "@ipedia/dsh-ichuny-codex",
  "version": "1.8.0",
  "description": "Dual ChatGPT providers for DeepSeek Harness: local Codex login and official SIWC OAuth Preview through isolated Codex app servers.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "codex",
    "openai",
    "chatgpt",
    "llm",
    "agent"
  ],
  "homepage": "https://github.com/ipedia825/dsh-ichuny-codex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipedia825/dsh-ichuny-codex.git"
  },
  "bugs": {
    "url": "https://github.com/ipedia825/dsh-ichuny-codex/issues"
  },
  "license": "Apache-2.0",
  "author": "ipedia",
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./oauth-controller": {
      "types": "./lib/oauth-controller.d.ts",
      "default": "./lib/oauth-controller.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./remote": {
      "types": "./lib/typert.remote.d.ts",
      "default": "./lib/typert.remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.13.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "installConfig": {
    "ignore-scripts": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "entry": "./client.js",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ scripts/ --max-warnings=0",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "typecheck": "tsc --noEmit",
    "validate:kb": "node scripts/validate-kb.mjs",
    "verify:required-files": "node scripts/verify-required-files.mjs",
    "verify:version": "node scripts/verify-version-sync.mjs",
    "verify": "npm run verify:required-files && npm run verify:version && npm run validate:kb",
    "audit": "node scripts/audit.mjs --ci",
    "audit:sarif": "node scripts/audit.mjs --sarif",
    "audit:permissions": "node scripts/audit.mjs --permissions",
    "audit:dependencies": "npm audit --audit-level=high --ignore-scripts",
    "audit:signatures": "npm audit signatures",
    "package:check": "npm pack --dry-run --ignore-scripts",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@openai/codex": "0.169.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-error": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
